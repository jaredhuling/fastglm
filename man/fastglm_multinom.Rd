p <- exp(eta) / rowSums(exp(eta))
d$y <- factor(c("low", "mid", "high")[
    apply(p, 1, function(q) sample.int(3, 1, prob = q))],
    levels = c("low", "mid", "high"))
fit <- fastglm_multinom(y ~ x1 + g, data = d)
fit$coefficients
head(fit$fitted.values)
}
