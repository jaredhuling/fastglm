\examples{
if (requireNamespace("emmeans", quietly = TRUE)) {
    set.seed(1)
    d <- data.frame(g = factor(rep(c("a", "b", "c"), 40)), x = rnorm(120))
    d$y <- rpois(120, exp(0.2 + 0.4 * (d$g == "b") + 0.3 * d$x))
    fit <- fastglm_nb(y ~ g + x, data = d)
    emmeans::emmeans(fit, "g", type = "response")
}
