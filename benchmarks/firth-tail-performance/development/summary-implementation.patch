diff --git a/src/binomial_firth.cpp b/src/binomial_firth.cpp
index bd4f35a..378138b 100644
--- a/src/binomial_firth.cpp
+++ b/src/binomial_firth.cpp
@@ -22,3 +22,60 @@ Rcpp::List binomial_firth_moments(Rcpp::NumericVector eta,Rcpp::NumericVector y,
