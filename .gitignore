# R CMD check / build artifacts
*.Rcheck/
*.tar.gz

# Benchmark raw results are regenerable and are not tracked. Only code,
# study-level summaries, and README inputs are tracked.
/benchmarks/*/**
!/benchmarks/*/**/
!/benchmarks/**/*.R
!/benchmarks/**/*.py
!/benchmarks/**/*.sh
!/benchmarks/**/*.Rmd
!/benchmarks/*/*.txt
!/benchmarks/*/*.csv
!/benchmarks/readme-results/**

# revdepcheck output (regenerable; not in package build either)
revdep/

# knitr artifacts from vignette precompilation
vignettes/cache/
vignettes/figure/

# R profiling output
Rprof.out

# testthat writes extracts of failing tests here
tests/testthat/_problems/

# rmarkdown preview of the README
README.html

# generated by configure from src/Makevars.in
src/Makevars
